            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"visits\": [\n    {\n      \"visitNumber\": 1,\n      \"visitName\": \"Screening\",\n      \"visitType\": \"SCREENING\",\n      \"typeOfVisitOrDose\": \"Screening/Treatment-Dose 1\",\n      \"durationDays\": null,\n      \"durationDisplay\": \"Duration from visit 1(Days)\",\n      \"windowPeriodBefore\": 2,\n      \"windowPeriodAfter\": 3,\n      \"windowPeriodDisplay\": \"2 days | 3 days\",\n      \"dayVisitSpecificCompPattern\": \"once\",\n      \"targetDayOffset\": 0,\n      \"isMandatory\": true,\n      \"requiresFasting\": false,\n      \"procedures\": [\"Physical exam\", \"Blood draw\", \"Informed consent\"],\n      \"visitCost\": 300.00\n    },\n    {\n      \"visitNumber\": 2,\n      \"visitName\": \"Treatment Visit 2\",\n      \"visitType\": \"TREATMENT\",\n      \"typeOfVisitOrDose\": \"Treatment-Dose 2\",\n      \"durationDays\": 30,\n      \"durationDisplay\": \"30 days\",\n      \"windowPeriodBefore\": 3,\n      \"windowPeriodAfter\": 3,\n      \"windowPeriodDisplay\": \"3 days | 3 days\",\n      \"dayVisitSpecificCompPattern\": \"once\",\n      \"targetDayOffset\": 30,\n      \"isMandatory\": true,\n      \"requiresFasting\": true,\n      \"procedures\": [\"Drug administration\", \"Vitals\", \"Blood draw\"],\n      \"visitCost\": 300.00\n    },\n    {\n      \"visitNumber\": 3,\n      \"visitName\": \"Treatment Visit 3\",\n      \"visitType\": \"TREATMENT\",\n      \"typeOfVisitOrDose\": \"Treatment-Dose 3\",\n      \"durationDays\": 60,\n      \"durationDisplay\": \"60 days\",\n      \"windowPeriodBefore\": 3,\n      \"windowPeriodAfter\": 5,\n      \"windowPeriodDisplay\": \"3 days | 5 days\",\n      \"targetDayOffset\": 60,\n      \"isMandatory\": true,\n      \"requiresFasting\": false,\n      \"procedures\": [\"Drug administration\", \"Vitals\", \"ECG\"],\n      \"visitCost\": 300.00\n    },\n    {\n      \"visitNumber\": 4,\n      \"visitName\": \"Follow-Up Visit 4\",\n      \"visitType\": \"FOLLOW_UP\",\n      \"typeOfVisitOrDose\": \"Follow-up\",\n      \"durationDays\": 90,\n      \"durationDisplay\": \"90 days\",\n      \"windowPeriodBefore\": 5,\n      \"windowPeriodAfter\": 5,\n      \"windowPeriodDisplay\": \"5 days | 5 days\",\n      \"targetDayOffset\": 90,\n      \"isMandatory\": true,\n      \"requiresFasting\": false,\n      \"procedures\": [\"Vitals\", \"Blood draw\", \"Adverse event assessment\"],\n      \"visitCost\": 300.00\n    },\n    {\n      \"visitNumber\": 5,\n      \"visitName\": \"End of Study\",\n      \"visitType\": \"END_OF_STUDY\",\n      \"typeOfVisitOrDose\": \"End of Study\",\n      \"durationDays\": 120,\n      \"durationDisplay\": \"120 days\",\n      \"windowPeriodBefore\": 5,\n      \"windowPeriodAfter\": 7,\n      \"windowPeriodDisplay\": \"5 days | 7 days\",\n      \"targetDayOffset\": 120,\n      \"isMandatory\": true,\n      \"requiresFasting\": false,\n      \"procedures\": [\"Full physical exam\", \"Labs\", \"Study drug return\", \"Exit interview\"],\n      \"visitCost\": 300.00\n    }\n  ]\n}"

          "request": {
            "method": "DELETE",
            "url": { "raw": "{{base}}/api/v1/studies/{{studyId}}/access/{{accessId}}", "host": ["{{base}}"], "path": ["api","v1","studies","{{studyId}}","access","{{accessId}}"] }
          }
        }
      ]
    },

    {
      "name": "11. Study Documents",
      "item": [
        {
          "name": "11.1 Upload Document (Metadata)",
          "request": {
            "method": "POST",
            "url": { "raw": "{{base}}/api/v1/studies/{{studyId}}/documents", "host": ["{{base}}"], "path": ["api","v1","studies","{{studyId}}","documents"] },
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"documentType\": \"PROTOCOL\",\n  \"documentName\": \"Protocol ABC-XY-001 v3.1\",\n  \"version\": \"v3.1\",\n  \"fileUrl\": \"https://docs.internal/studies/s0000001/protocol-v3.1.pdf\",\n  \"fileSizeBytes\": 2456789\n}"
            }
          }
        },
        {
          "name": "11.2 List Study Documents",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{base}}/api/v1/studies/{{studyId}}/documents?current=true",
              "host": ["{{base}}"], "path": ["api","v1","studies","{{studyId}}","documents"],
              "query": [
                { "key": "type",    "value": "", "disabled": true },
                { "key": "current", "value": "true" }
              ]
            }
          }
        }
      ]
    },

    {
      "name": "12. Audit Log",
      "item": [
        {
          "name": "12.1 Query Audit Trail (Study)",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{base}}/api/v1/audit?entityType=STUDY&entityId={{studyId}}&page=1&size=20",
              "host": ["{{base}}"], "path": ["api","v1","audit"],
              "query": [
                { "key": "entityType",  "value": "STUDY" },
                { "key": "entityId",    "value": "{{studyId}}" },
                { "key": "action",      "value": "", "disabled": true },
                { "key": "startDate",   "value": "", "disabled": true },
                { "key": "endDate",     "value": "", "disabled": true },
                { "key": "performedBy", "value": "", "disabled": true },
                { "key": "page",        "value": "1" },
                { "key": "size",        "value": "20" }
              ]
            }
          }
        }
      ]
    },

    {
      "name": "H2 Console & Swagger",

  "item": [

    {
      "name": "1. MPA (Master Provider Agreement)",
      "item": [
        {
          "name": "1.1 Create MPA",
          "request": {
            "method": "POST",
            "url": { "raw": "{{base}}/api/v1/mpa", "host": ["{{base}}"], "path": ["api","v1","mpa"] },
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"mpaNumber\": \"MPA-2026-002\",\n  \"mpaName\": \"Master Agreement - City Medical Group\",\n  \"organizationName\": \"City Medical Group LLC\",\n  \"contractType\": \"MASTER\",\n  \"effectiveDate\": \"2026-05-01\",\n  \"expirationDate\": \"2029-04-30\",\n  \"contactName\": \"Dr. Sarah Mitchell\",\n  \"contactEmail\": \"s.mitchell@citymedical.com\",\n  \"contactPhone\": \"+1-212-555-0100\",\n  \"notes\": \"Initial 3-year master agreement\"\n}"
            }
          }
        },
        {
          "name": "1.2 Get MPA by ID",
          "request": {
            "method": "GET",
            "url": { "raw": "{{base}}/api/v1/mpa/{{mpaId}}", "host": ["{{base}}"], "path": ["api","v1","mpa","{{mpaId}}"] }
          }
        },
        {
          "name": "1.3 List MPAs",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{base}}/api/v1/mpa?status=ACTIVE&page=1&size=20",
              "host": ["{{base}}"], "path": ["api","v1","mpa"],
              "query": [
                { "key": "status", "value": "ACTIVE" },
                { "key": "page",   "value": "1" },
                { "key": "size",   "value": "20" }
              ]
            }
          }
        },
        {
          "name": "1.4 Update MPA",
          "request": {
            "method": "PUT",
            "url": { "raw": "{{base}}/api/v1/mpa/{{mpaId}}", "host": ["{{base}}"], "path": ["api","v1","mpa","{{mpaId}}"] },
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"mpaName\": \"Master Agreement - Metro Health Network (Amended)\",\n  \"expirationDate\": \"2029-12-31\",\n  \"contactName\": \"Dr. James Chen\",\n  \"contactEmail\": \"j.chen@metrohealth.com\",\n  \"notes\": \"Extended by 1 year per amendment A-001\"\n}"
            }
          }
        }
      ]
    },


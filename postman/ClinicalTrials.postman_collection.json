    {
      "name": "4. Studies",
      "item": [
        {
          "name": "4.1 Create Study",
          "request": {
            "method": "POST",
            "url": { "raw": "{{base}}/api/v1/studies", "host": ["{{base}}"], "path": ["api","v1","studies"] },
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"studyNumber\": \"DEF-AB-002\",\n  \"studyName\": \"Safety Study of Drug Y in Hypertension\",\n  \"indication\": \"Hypertension\",\n  \"phase\": \"PHASE_II\",\n  \"protocolNumber\": \"PROT-2026-HT-002\",\n  \"sponsorName\": \"BioTrial Inc.\",\n  \"therapeuticArea\": \"Cardiology\",\n  \"noOfPatientsToEnroll\": 30,\n  \"totalNumberOfVisits\": 4,\n  \"dateFirstPatientScreening\": \"2026-06-01\",\n  \"dateFirstPatientLastVisit\": \"2026-12-01\",\n  \"dateLastPatientFirstVisit\": \"2026-09-01\",\n  \"dateLastPatientLastVisit\": \"2027-03-01\",\n  \"createdByPiId\": \"{{piId}}\"\n}"
